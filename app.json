{
  "expo": {
    "name": "Dige-App-2025",
    "slug": "Dige-App-2025",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./Assets/Image/Logo.png",
    "scheme": "digeapp2025",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./Assets/Image/Logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./Assets/Image/Logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.urpiriodev.DigeApp2025",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyC9LPOPDJTJjjgmIfSzWzhrKaITkKtm_70"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./Assets/Image/Logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-maps",
        {
          "requestLocationPermission": true,
          "locationPermission": "Allow $(PRODUCT_NAME) to use your location"
        }
      ],
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone",
          "recordAudioAndroid": true
        }
      ],
      "expo-video",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6ad7a0e0-de60-447f-9838-04fb8bf2da40"
      }
    }
  }
}
